# This file contains config options that control the UI of the git command-line
# tools.

[color]
  ui = true

[diff]
  colorMoved = default

[merge]
  tool = vimdiff
  conflictstyle = diff3

[core]
  pager = git-delta-themed

[interactive]
  diffFilter = git-delta-themed --color-only

# Light/dark is not hardcoded here. git-delta-themed re-reads the color-theme
# state file on EVERY invocation (rather than relying on the shell's exported
# DELTA_FEATURES, which is only fresh in the shell that set it) and exports
# DELTA_FEATURES="theme-<name>" before exec-ing the real delta, selecting one of
# the theme features below. This keeps delta correct even when it's launched
# from nvim, lazygit, or any other process started before the last light/dark
# switch.
[delta]
  line-numbers = true
  side-by-side = false

[delta "theme-dark"]
  dark = true

[delta "theme-light"]
  light = true
