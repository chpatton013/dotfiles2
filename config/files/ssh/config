# Enable compression everywhere.
Host *
  Compression yes

# Use ssh agent and keychain to manage keys if available.
Host *
  AddKeysToAgent yes
  ForwardAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes

# Post-quantum SSH key exchange. OpenSSH's PQ protection lives in the key
# *exchange* (session confidentiality), which is what defends against
# "harvest-now, decrypt-later" attacks; host-key *authentication* has no
# standardized PQ signature algorithm yet, so nothing to do there.
#
# The leading '^' prepends these algorithms to OpenSSH's built-in default
# KexAlgorithms list, so classical algorithms remain available as fallbacks
# for older servers -- this prefers PQ rather than forcing it (PQ-only would
# break connections to pre-9.0 servers).
#
# Only sntrup761x25519-sha512@openssh.com (OpenSSH 9.0+) is listed. Unknown
# algorithm names abort the client, and Ubuntu 24.04 ships OpenSSH 9.6, which
# lacks mlkem768x25519-sha256 (9.9+). Clients that do support mlkem768 still
# keep it in their default list, directly after the prepended sntrup761.
Host *
  KexAlgorithms ^sntrup761x25519-sha512@openssh.com

# Load all config fragments.
Include ~/.ssh/config.d/*

# Settings for interactive sessions.
Match Tagged "*tty*"
  ForwardX11 yes
  ForwardX11Trusted yes
  RequestTTY yes
  ServerAliveCountMax 10
  ServerAliveInterval 300

# Pooled connections with shared control sockets.
Match Tagged "*ctrlsock*"
  ControlMaster auto
  ControlPath ~/.ssh/sockets/ssh_mux:%r@%h:%p.sock
  ControlPersist yes
